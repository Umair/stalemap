{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    // We import CommonJS packages as namespaces only, so the code runs the same under any bundler.
    "allowSyntheticDefaultImports": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "test", "*.ts"]
}
