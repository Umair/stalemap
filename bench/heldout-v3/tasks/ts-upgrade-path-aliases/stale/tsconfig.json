{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": "./src",
    "paths": {
      "@lib/*": ["lib/*"],
      "@config": ["config/index.ts"]
    }
  },
  "include": ["src", "test", "*.ts"]
}
