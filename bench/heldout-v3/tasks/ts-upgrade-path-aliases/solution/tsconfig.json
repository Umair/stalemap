{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@lib/*": ["./src/lib/*"],
      "@config": ["./src/config/index.ts"],
      "*": ["./src/*"]
    }
  },
  "include": ["src", "test", "*.ts"]
}
