{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "*.ts"]
}
