{
  "description": "Notes about dependencies that changed after the model's training cutoff at session start, and a type-check guard after each edit.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "npx",
            "args": [
              "-y",
              "stalemap@0.4.1",
              "hook",
              "session-start"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx",
            "args": [
              "-y",
              "stalemap@0.4.1",
              "hook",
              "post-edit"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
